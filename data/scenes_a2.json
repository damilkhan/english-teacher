{
  "version": 1,
  "level": "A2",
  "scenes": [
    {
      "id": "a2.restaurant",
      "title": "At the Restaurant",
      "title_ru": "В ресторане",
      "lesson": "city/2.1",
      "point": "city/point_2",
      "card": {
        "role": "waiter",
        "ru": "Официант в небольшом американском ресторане. Его работа: принять заказ, принести еду и напитки, принести счёт, попрощаться. Говорит коротко и вежливо. Он НЕ друг гостю: про жизнь, семью, работу и планы не спрашивает — его дело столик и еда.",
        "en": "You are the waiter in a small American restaurant. Your job is to take the order, bring the food and drinks, bring the bill and say goodbye. You speak short and polite. You are NOT a friend of the guest: you never ask about their life, family, job or plans — your job is the table and the food."
      },
      "steps": [
        {
          "n": 1,
          "title": "Приветствие и посадка",
          "questions": [
            {
              "en": "Good evening! How many people are with you?",
              "hint": "сколько вас",
              "slot": "people"
            },
            {
              "en": "Would you like a table by the window?",
              "hint": "у окна?",
              "slot": "table"
            },
            {
              "en": "Here is your table. Can I get you something to drink?",
              "hint": "что-нибудь выпить?",
              "slot": "drink"
            }
          ]
        },
        {
          "n": 2,
          "title": "Меню",
          "questions": [
            {
              "en": "Here is the menu. Would you like a few minutes to look at it?",
              "hint": "посмотреть меню?",
              "slot": "menu"
            },
            {
              "en": "Are you ready to order?",
              "hint": "готовы заказать?",
              "slot": "ready"
            }
          ]
        },
        {
          "n": 3,
          "title": "Заказ",
          "questions": [
            {
              "en": "What would you like to start with?",
              "hint": "с чего начнёте?",
              "slot": "starter"
            },
            {
              "en": "And for the main course?",
              "hint": "горячее?",
              "slot": "main"
            },
            {
              "en": "Would you like soup or salad with that?",
              "hint": "суп или салат?",
              "slot": "side"
            }
          ]
        },
        {
          "n": 4,
          "title": "Принесли еду",
          "questions": [
            {
              "en": "Here is your food. Enjoy your meal!",
              "hint": "поблагодари",
              "slot": "thanks"
            },
            {
              "en": "Is everything all right with your food?",
              "hint": "всё в порядке?",
              "slot": "food_ok"
            },
            {
              "en": "Would you like some more bread?",
              "hint": "ещё хлеба?",
              "slot": "bread"
            }
          ]
        },
        {
          "n": 5,
          "title": "Десерт",
          "questions": [
            {
              "en": "Would you like to see the dessert menu?",
              "hint": "десерт?",
              "slot": "dessert"
            }
          ]
        },
        {
          "n": 6,
          "title": "Счёт и уход",
          "questions": [
            {
              "en": "Would you like anything else?",
              "hint": "ещё что-нибудь?",
              "slot": "anything"
            },
            {
              "en": "Here is your bill. Card or cash?",
              "hint": "картой или наличными?",
              "slot": "payment"
            },
            {
              "en": "Thank you. Have a nice evening!",
              "hint": "попрощайся",
              "slot": "goodbye"
            }
          ]
        }
      ]
    },
    {
      "id": "a2.shop",
      "title": "In the Shop",
      "title_ru": "В магазине",
      "lesson": "city/3.1",
      "point": "city/point_3",
      "card": {
        "role": "shop assistant",
        "ru": "Продавец в небольшом магазине одежды. Его работа: спросить, что нужно, подсказать размер и цвет, показать примерочную, назвать цену, принять оплату, отдать пакет и чек, попрощаться. Говорит коротко и вежливо. Он НЕ друг покупателю: про жизнь, семью и планы не спрашивает — его дело товар и деньги.",
        "en": "You are the shop assistant in a small clothes shop. Your job is to ask what the customer needs, help with size and colour, show the changing room, tell the price, take the payment, give a bag and a receipt and say goodbye. You speak short and polite. You are NOT a friend of the customer: you never ask about their life, family or plans — your job is the goods and the money."
      },
      "steps": [
        {
          "n": 1,
          "title": "Продавец здоровается",
          "questions": [
            {
              "en": "Good morning! Can I help you?",
              "hint": "помочь?",
              "slot": "shop_help"
            },
            {
              "en": "What are you looking for?",
              "hint": "что ищете?",
              "slot": "shop_item"
            }
          ]
        },
        {
          "n": 2,
          "title": "Размер и цвет",
          "questions": [
            {
              "en": "What size do you wear?",
              "hint": "какой размер?",
              "slot": "shop_size"
            },
            {
              "en": "What colour would you like?",
              "hint": "какой цвет?",
              "slot": "shop_colour"
            },
            {
              "en": "We have this one in black. Do you like it?",
              "hint": "нравится?",
              "slot": "shop_like"
            }
          ]
        },
        {
          "n": 3,
          "title": "Примерка",
          "questions": [
            {
              "en": "Would you like to try it on?",
              "hint": "примерите?",
              "slot": "shop_try"
            },
            {
              "en": "The changing room is over there. Is the size OK?",
              "hint": "размер подходит?",
              "slot": "shop_fit"
            },
            {
              "en": "Do you want a bigger size?",
              "hint": "размер побольше?",
              "slot": "shop_bigger"
            }
          ]
        },
        {
          "n": 4,
          "title": "Цена",
          "questions": [
            {
              "en": "It costs forty dollars. Is that OK?",
              "hint": "сорок долларов, хорошо?",
              "slot": "shop_price"
            },
            {
              "en": "Do you want to take it?",
              "hint": "берёте?",
              "slot": "shop_take"
            }
          ]
        },
        {
          "n": 5,
          "title": "Оплата",
          "questions": [
            {
              "en": "How would you like to pay?",
              "hint": "как платите?",
              "slot": "shop_pay"
            },
            {
              "en": "Can I have your card, please?",
              "hint": "дайте карту",
              "slot": "shop_card"
            }
          ]
        },
        {
          "n": 6,
          "title": "Пакет, чек, уход",
          "questions": [
            {
              "en": "Do you need a bag?",
              "hint": "нужен пакет?",
              "slot": "shop_bag"
            },
            {
              "en": "Would you like a receipt?",
              "hint": "нужен чек?",
              "slot": "shop_receipt"
            },
            {
              "en": "Thank you for your visit. Have a nice day!",
              "hint": "до свидания",
              "slot": "shop_bye"
            }
          ]
        }
      ]
    }
  ]
}
